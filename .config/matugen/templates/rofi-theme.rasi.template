* {
    bg:               {{colors.surface_container_lowest.default.hex}};
    surface:          {{colors.surface_container_low.default.hex}};
    surface-high:     {{colors.surface_container.default.hex}};

    fg:               {{colors.on_surface.default.hex}};
    fg-muted:         {{colors.on_surface_variant.default.hex}};

    accent:           {{colors.primary.default.hex}};
    accent-secondary: {{colors.secondary.default.hex}};

    selected-bg:      {{colors.primary_container.default.hex}};
    selected-fg:      {{colors.on_primary_container.default.hex}};

    border-col:       {{colors.outline_variant.default.hex}};

    font: "JetBrains Mono 12";
}

window {
    width: 430px;

    background-color: @bg;

    border: 1px;
    border-color: @border-col;
    border-radius: 18px;

    padding: 14px;
}

mainbox {
    background-color: transparent;

    children: [
        inputbar,
        listview
    ];

    spacing: 12px;
}

inputbar {
    background-color: @surface;

    border-radius: 12px;

    padding: 12px 14px;

    children: [
        entry
    ];
}

entry {
    background-color: transparent;

    text-color: @fg;

    placeholder: "Search applications...";
    placeholder-color: @fg-muted;

    cursor-color: @accent;
}

listview {
    background-color: transparent;

    lines: 7;
    columns: 1;

    fixed-height: false;
    dynamic: true;

    spacing: 3px;

    scrollbar: false;
}

element {
    background-color: transparent;

    text-color: @fg;

    padding: 10px 12px;

    border-radius: 10px;

    spacing: 10px;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @selected-bg;
    text-color: @selected-fg;
}

element-icon {
    background-color: transparent;

    size: 27px;

    margin: 0px 10px 0px 0px;
}

element-text {
    background-color: transparent;

    text-color: inherit;

    vertical-align: 0.5;
}
