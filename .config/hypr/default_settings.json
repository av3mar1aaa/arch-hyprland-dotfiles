      "command": "togglesplit"
    },
    {
      "type": "bind",
      "mods": "SUPER",
      "key": "M",
      "dispatcher": "exit",
      "command": ""
    },
    {
      "type": "bind",
      "mods": "SUPER",
      "key": "E",
      "dispatcher": "exec",
      "command": "dolphin"
    },
    {
      "type": "bind",
      "mods": "SUPER",
      "key": "SPACE",
      "dispatcher": "exec",
      "command": "rofi -show drun"
    },
    {
      "type": "bind",
      "mods": "SUPER",
      "key": "B",
      "dispatcher": "exec",
      "command": "cliphist list | rofi -dmenu -p \"Clipboard\" | cliphist decode | wl-copy"
    },
    {
      "type": "bind",
      "mods": "SUPER",
      "key": "L",
      "dispatcher": "exec",
      "command": "hyprlock"
    },
    {
      "type": "bind",
      "mods": "SUPER",
      "key": "TAB",
      "dispatcher": "exec",
      "command": "bash ~/.config/hypr/scripts/qs_manager.sh toggle wallpaper"
    },
    {
      "type": "bind",
      "mods": "SUPER",
      "key": "PAGE_UP",
      "dispatcher": "exec",
      "command": "$HOME/.local/bin/screenshot-full"
    },
    {
      "type": "bind",
      "mods": "SUPER",
      "key": "PAGE_DOWN",
      "dispatcher": "exec",
      "command": "$HOME/.local/bin/screenshot-region"
    },
