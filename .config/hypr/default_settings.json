{
  "uiScale": 1.0,
  "openGuideAtStartup": true,
  "topbarHelpIcon": true,
  "workspaceCount": 8,
  "wallpaperDir": "/home/ave/Pictures/Wallpapers",
  "language": "us,ru",
  "kbOptions": "grp:alt_shift_toggle",
  "monitors": [
    {
      "name": "DP-1",
      "resW": 2560,
      "resH": 1440,
      "rate": 180.0,
      "x": 0,
      "y": 0,
      "scale": 1.0,
      "transform": 0
    }
  ],
  "keybinds": [
    {
      "type": "bind",
      "mods": "SUPER",
      "key": "RETURN",
      "dispatcher": "exec",
      "command": "kitty"
    },
    {
      "type": "bind",
      "mods": "SUPER SHIFT",
      "key": "RETURN",
      "dispatcher": "exec",
      "command": "$HOME/.local/bin/edex-ui"
    },
    {
      "type": "bind",
      "mods": "SUPER",
      "key": "C",
      "dispatcher": "killactive",
      "command": ""
    },
    {
      "type": "bind",
      "mods": "SUPER",
      "key": "Q",
      "dispatcher": "exec",
      "command": "$HOME/.local/bin/close-workspace-windows"
    },
    {
      "type": "bind",
      "mods": "SUPER",
      "key": "V",
      "dispatcher": "togglefloating",
      "command": ""
    },
    {
      "type": "bind",
      "mods": "SUPER",
      "key": "F",
      "dispatcher": "fullscreen",
      "command": "0"
    },
    {
