{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch",
    "padding": {
      "top": 2,
      "right": 6
    },
    "color": {
      "1": "#bec2ff",
      "2": "#c5c4dd",
      "3": "#e8b9d5"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#bec2ff",
      "title": "#c5c4dd",
      "output": "#e4e1e9",
      "separator": "#91909a"
    },
    "key": {
      "width": 13
    },
    "bar": {
      "char": {
        "elapsed": "━",
        "total": "─"
      },
      "border": {
        "left": "",
        "right": ""
      },
      "width": 18
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;2;190;194;255m╭────────────────────────────────────────╮\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;190;194;255m│  ARCH SECURITY TERMINAL // NODE-01     │\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;190;194;255m╰────────────────────────────────────────╯\u001b[0m"
    },
    {
      "type": "title",
      "key": "󰌆 IDENTITY",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;197;196;221m┌─[ SYSTEM CORE ]────────────────────────\u001b[0m"
    },
    {
      "type": "os",
      "key": "│ distro"
    },
    {
      "type": "kernel",
      "key": "│ kernel"
    },
    {
      "type": "wm",
      "key": "│ session"
    },
    {
      "type": "shell",
      "key": "│ shell"
    },
    {
      "type": "terminal",
      "key": "│ terminal"
    },
    {
      "type": "uptime",
      "key": "│ uptime"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;197;196;221m└────────────────────────────────────────\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;197;196;221m┌─[ HARDWARE MATRIX ]────────────────────\u001b[0m"
    },
    {
      "type": "cpu",
      "key": "│ cpu"
    },
    {
      "type": "gpu",
      "key": "│ gpu"
    },
    {
      "type": "memory",
      "key": "│ memory"
    },
    {
      "type": "disk",
      "key": "│ storage",
      "folders": "/"
    },
    {
      "type": "display",
      "key": "│ display",
      "compactType": "original-with-refresh-rate"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;197;196;221m└────────────────────────────────────────\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;197;196;221m┌─[ SOFTWARE LOADOUT ]───────────────────\u001b[0m"
    },
    {
      "type": "packages",
      "key": "│ packages"
    },
    {
      "type": "processes",
      "key": "│ processes"
    },
    {
      "type": "localip",
      "key": "│ local-ip",
      "showIpv4": true,
      "showIpv6": false
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;197;196;221m└────────────────────────────────────────\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;197;196;221m[ ACCESS GRANTED ]  SYSTEM STATUS: ONLINE\u001b[0m"
    },
    {
      "type": "colors",
      "symbol": "diamond"
    }
  ]
}
